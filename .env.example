# ============================================================================
# RELAY PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================

# 1. GITLAB INTEGRATION (READ-ONLY)
# Personal Access Token or Project Access Token with 'read_api' or 'read_repository' scope.
# Note: Keep tokens strictly server-side. They are never exposed to browser client bundles.
GITLAB_ACCESS_TOKEN=""

# Optional: Custom Self-Hosted GitLab Host (Defaults to gitlab.com)
ALLOWED_GITLAB_HOST="gitlab.com"


# 2. SUPABASE POSTGRESQL & AUTH
# Set these to enable remote Supabase persistence with Row-Level Security.
# Note: Roles are derived exclusively from trusted `app_metadata.role`, never `user_metadata`.
# If omitted, RELAY runs in durable dual-mode session persistence for demonstration.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""


# 3. AI / LLM PROVIDER (OPTIONAL — FOR PHASE 3)
# RELAY operates fully offline without paid APIs using its deterministic heuristic engine.
# Set an API key only if deep semantic LLM reasoning is desired.
GEMINI_API_KEY=""
OPENAI_API_KEY=""


# 4. SECURITY & SESSION SIGNING (MANDATORY FOR PRODUCTION)
# Cryptographic secret used to sign synthetic demonstration session tokens (HMAC-SHA256).
# In production, RELAY fails closed if this variable is missing.
# Generate a secure 32+ character string using: `openssl rand -hex 32`
DEMO_SESSION_SECRET=""
